<?xml version="1.0" encoding="UTF-8"?>
<POWERMART CREATION_DATE="03/14/2002 11:47:22" REPOSITORY_VERSION="151.90">
<REPOSITORY NAME="REP_PENSADM01" VERSION="151" CODEPAGE="us-ascii" DATABASETYPE="Oracle">
<FOLDER NAME="PENS_MONTHLY" GROUP="" OWNER="RSIMMONS" SHARED="NOTSHARED" DESCRIPTION="" PERMISSIONS="rwx---r--">

<SOURCE NAME="MBR_MASTER" DBDNAME="FF_PENSADM" DATABASETYPE="Flat File">
  <SOURCEFIELD NAME="MBR_ID" DATATYPE="string" PRECISION="12"/>
  <SOURCEFIELD NAME="BIRTH_DT" DATATYPE="date"/>
  <SOURCEFIELD NAME="HIRE_DT" DATATYPE="date"/>
  <SOURCEFIELD NAME="PRI_TERM_DT" DATATYPE="date" NULLABLE="YES"/>
  <SOURCEFIELD NAME="REHIRE_DT" DATATYPE="date" NULLABLE="YES"/>
  <SOURCEFIELD NAME="TERM_DT" DATATYPE="date" NULLABLE="YES"/>
  <SOURCEFIELD NAME="RET_DT" DATATYPE="date" NULLABLE="YES"/>
  <SOURCEFIELD NAME="PLAN_CD" DATATYPE="string" PRECISION="8"/>
  <SOURCEFIELD NAME="SURV_OPT" DATATYPE="string" PRECISION="6"/>
</SOURCE>
<SOURCE NAME="SAL_HIST" DBDNAME="FF_PENSADM" DATABASETYPE="Flat File">
  <SOURCEFIELD NAME="MBR_ID" DATATYPE="string" PRECISION="12"/>
  <SOURCEFIELD NAME="EFF_DT" DATATYPE="date"/>
  <SOURCEFIELD NAME="ANN_SAL" DATATYPE="decimal" PRECISION="12" SCALE="2"/>
</SOURCE>
<SOURCE NAME="PENS_ADJ" DBDNAME="FF_PENSADM" DATABASETYPE="Flat File">
  <SOURCEFIELD NAME="MBR_ID" DATATYPE="string" PRECISION="12"/>
  <SOURCEFIELD NAME="EFF_DT" DATATYPE="date"/>
  <SOURCEFIELD NAME="POSTED_DT" DATATYPE="date"/>
  <SOURCEFIELD NAME="CORR_ANN_SAL" DATATYPE="decimal" PRECISION="12" SCALE="2"/>
  <SOURCEFIELD NAME="RSN_CD" DATATYPE="string" PRECISION="40"/>
</SOURCE>
<TARGET NAME="BEN_PAY" DATABASETYPE="Flat File">
  <TARGETFIELD NAME="MBR_ID" DATATYPE="string" PRECISION="12"/>
  <TARGETFIELD NAME="SVC_YRS" DATATYPE="decimal" PRECISION="8" SCALE="4"/>
  <TARGETFIELD NAME="FAS" DATATYPE="decimal" PRECISION="12" SCALE="2"/>
  <TARGETFIELD NAME="EARLY_FCT" DATATYPE="decimal" PRECISION="6" SCALE="4"/>
  <TARGETFIELD NAME="SURV_FCT" DATATYPE="decimal" PRECISION="6" SCALE="4"/>
  <TARGETFIELD NAME="MO_BEN" DATATYPE="decimal" PRECISION="12" SCALE="2"/>
</TARGET>

<MAPPING NAME="m_SAL_EFF_01" DESCRIPTION="" ISVALID="YES">
  <TRANSFORMATION NAME="SQ_SAL_HIST" TYPE="Source Qualifier"/>
  <TRANSFORMATION NAME="LKP_PENS_ADJ" TYPE="Lookup Procedure">
    <TABLEATTRIBUTE NAME="Lookup Sql Override" VALUE="SELECT CORR_ANN_SAL, POSTED_DT FROM PENS_ADJ WHERE MBR_ID = ?MBR_ID? AND EFF_DT = ?EFF_DT? AND POSTED_DT &lt;= $$RUN_PRD_END ORDER BY POSTED_DT"/>
    <TABLEATTRIBUTE NAME="Lookup policy on multiple match" VALUE="Use Last Value"/>
  </TRANSFORMATION>
  <TRANSFORMATION NAME="EXP_EFF_SAL" TYPE="Expression">
    <TRANSFORMFIELD NAME="EFF_SAL" PORTTYPE="OUTPUT" DATATYPE="decimal" PRECISION="12" SCALE="2"
      EXPRESSION="IIF(ISNULL(CORR_ANN_SAL), ANN_SAL, CORR_ANN_SAL)"/>
    <TRANSFORMFIELD NAME="EFF_YR" PORTTYPE="OUTPUT" DATATYPE="integer"
      EXPRESSION="GET_DATE_PART(EFF_DT,'YYYY')"/>
  </TRANSFORMATION>
  <INSTANCE NAME="SQ_SAL_HIST" TYPE="SOURCE QUALIFIER"/>
  <INSTANCE NAME="LKP_PENS_ADJ" TYPE="LOOKUP"/>
  <INSTANCE NAME="EXP_EFF_SAL" TYPE="EXPRESSION"/>
</MAPPING>

<MAPPING NAME="m_SVC_VEST_02" DESCRIPTION="" ISVALID="YES">
  <TRANSFORMATION NAME="SQ_MBR_MASTER" TYPE="Source Qualifier"/>
  <TRANSFORMATION NAME="EXP_SVC" TYPE="Expression">
    <TRANSFORMFIELD NAME="V_SVC_MO" PORTTYPE="LOCAL VARIABLE" DATATYPE="decimal" PRECISION="10" SCALE="4"
      EXPRESSION="IIF(ISNULL(REHIRE_DT), MONTHS_BETWEEN(TERM_DT, HIRE_DT), MONTHS_BETWEEN(PRI_TERM_DT, HIRE_DT) + MONTHS_BETWEEN(TERM_DT, REHIRE_DT))"/>
    <TRANSFORMFIELD NAME="SVC_YRS" PORTTYPE="OUTPUT" DATATYPE="decimal" PRECISION="8" SCALE="4"
      EXPRESSION="TRUNC(V_SVC_MO / 12, 4)"/>
    <TRANSFORMFIELD NAME="VEST_FLG" PORTTYPE="OUTPUT" DATATYPE="integer"
      EXPRESSION="IIF(SVC_YRS &gt;= 5, 1, 0)"/>
    <TRANSFORMFIELD NAME="V_AGE_MO" PORTTYPE="LOCAL VARIABLE" DATATYPE="decimal" PRECISION="10" SCALE="4"
      EXPRESSION="MONTHS_BETWEEN(RET_DT, BIRTH_DT)"/>
    <TRANSFORMFIELD NAME="EARLY_FCT" PORTTYPE="OUTPUT" DATATYPE="decimal" PRECISION="6" SCALE="4"
      EXPRESSION="IIF(V_AGE_MO &gt;= 780, 1, 1 - (0.005 * TRUNC(780 - V_AGE_MO, 0)))"/>
    <TRANSFORMFIELD NAME="SURV_FCT" PORTTYPE="OUTPUT" DATATYPE="decimal" PRECISION="6" SCALE="4"
      EXPRESSION="DECODE(SURV_OPT, 'js50', 0.90, 'js100', 0.84, 1.0)"/>
    <TRANSFORMFIELD NAME="ACCR_RT" PORTTYPE="OUTPUT" DATATYPE="decimal" PRECISION="8" SCALE="6"
      EXPRESSION="DECODE(PLAN_CD, 'clergy', 0.0175, 'lay', 0.015, 0)"/>
  </TRANSFORMATION>
  <TRANSFORMATION NAME="FIL_PAYABLE" TYPE="Filter">
    <TABLEATTRIBUTE NAME="Filter Condition"
      VALUE="VEST_FLG = 1 AND NOT ISNULL(RET_DT) AND RET_DT &lt;= $$RUN_PRD_END"/>
  </TRANSFORMATION>
  <INSTANCE NAME="SQ_MBR_MASTER" TYPE="SOURCE QUALIFIER"/>
  <INSTANCE NAME="EXP_SVC" TYPE="EXPRESSION"/>
  <INSTANCE NAME="FIL_PAYABLE" TYPE="FILTER"/>
</MAPPING>

<MAPPING NAME="m_BEN_CALC_03" DESCRIPTION="" ISVALID="YES">
  <TRANSFORMATION NAME="SRT_SAL_DESC" TYPE="Sorter">
    <TABLEATTRIBUTE NAME="Sort Keys" VALUE="MBR_ID ASC, EFF_YR DESC"/>
  </TRANSFORMATION>
  <TRANSFORMATION NAME="EXP_FAS_WIN" TYPE="Expression">
    <TABLEATTRIBUTE NAME="Tracing Level" VALUE="Terse"/>
    <TRANSFORMFIELD NAME="V_YR_RNK" PORTTYPE="LOCAL VARIABLE" DATATYPE="integer"
      EXPRESSION="IIF(MBR_ID = V_PREV_MBR, V_YR_RNK + 1, 1)"/>
    <TRANSFORMFIELD NAME="V_WIN_SUM" PORTTYPE="LOCAL VARIABLE" DATATYPE="decimal" PRECISION="14" SCALE="2"
      EXPRESSION="IIF(V_YR_RNK &lt;= 10, EFF_SAL + V_SAL_1 + V_SAL_2, V_WIN_SUM)"/>
    <TRANSFORMFIELD NAME="V_FAS_MAX" PORTTYPE="LOCAL VARIABLE" DATATYPE="decimal" PRECISION="14" SCALE="2"
      EXPRESSION="IIF(V_YR_RNK &gt;= 3 AND V_YR_RNK &lt;= 10 AND V_WIN_SUM / 3 &gt; V_FAS_MAX, V_WIN_SUM / 3, IIF(MBR_ID = V_PREV_MBR, V_FAS_MAX, 0))"/>
    <TRANSFORMFIELD NAME="V_SAL_2" PORTTYPE="LOCAL VARIABLE" DATATYPE="decimal" PRECISION="12" SCALE="2" EXPRESSION="V_SAL_1"/>
    <TRANSFORMFIELD NAME="V_SAL_1" PORTTYPE="LOCAL VARIABLE" DATATYPE="decimal" PRECISION="12" SCALE="2" EXPRESSION="EFF_SAL"/>
    <TRANSFORMFIELD NAME="V_PREV_MBR" PORTTYPE="LOCAL VARIABLE" DATATYPE="string" PRECISION="12" EXPRESSION="MBR_ID"/>
    <TRANSFORMFIELD NAME="FAS_OUT" PORTTYPE="OUTPUT" DATATYPE="decimal" PRECISION="12" SCALE="2"
      EXPRESSION="ROUND(V_FAS_MAX, 2)"/>
  </TRANSFORMATION>
  <TRANSFORMATION NAME="AGG_FAS" TYPE="Aggregator">
    <TABLEATTRIBUTE NAME="Group By Ports" VALUE="MBR_ID"/>
    <TRANSFORMFIELD NAME="FAS" PORTTYPE="OUTPUT" DATATYPE="decimal" PRECISION="12" SCALE="2" EXPRESSION="LAST(FAS_OUT)"/>
  </TRANSFORMATION>
  <TRANSFORMATION NAME="JNR_SVC" TYPE="Joiner">
    <TABLEATTRIBUTE NAME="Join Condition" VALUE="MBR_ID = MBR_ID1"/>
    <TABLEATTRIBUTE NAME="Join Type" VALUE="Normal Join"/>
  </TRANSFORMATION>
  <TRANSFORMATION NAME="EXP_BEN" TYPE="Expression">
    <TRANSFORMFIELD NAME="MO_BEN" PORTTYPE="OUTPUT" DATATYPE="decimal" PRECISION="12" SCALE="2"
      EXPRESSION="ROUND(FAS * ACCR_RT * SVC_YRS * EARLY_FCT * SURV_FCT / 12, 2)"/>
  </TRANSFORMATION>
  <INSTANCE NAME="SRT_SAL_DESC" TYPE="SORTER"/>
  <INSTANCE NAME="EXP_FAS_WIN" TYPE="EXPRESSION"/>
  <INSTANCE NAME="AGG_FAS" TYPE="AGGREGATOR"/>
  <INSTANCE NAME="JNR_SVC" TYPE="JOINER"/>
  <INSTANCE NAME="EXP_BEN" TYPE="EXPRESSION"/>
</MAPPING>

<SESSION NAME="s_m_SAL_EFF_01" MAPPINGNAME="m_SAL_EFF_01" ISVALID="YES">
  <SESSIONEXTENSION NAME="File Reader" SUBTYPE="Reader" TRANSFORMATIONTYPE="Source Qualifier"/>
  <ATTRIBUTE NAME="Source filename" VALUE="$PMSourceFileDir\SAL_HIST.dat"/>
  <ATTRIBUTE NAME="Lookup source filename" VALUE="$PMSourceFileDir\PENS_ADJ.dat"/>
  <ATTRIBUTE NAME="Output filename" VALUE="$PMTargetFileDir\SAL_EFF.dat"/>
</SESSION>
<SESSION NAME="s_m_SVC_VEST_02" MAPPINGNAME="m_SVC_VEST_02" ISVALID="YES">
  <ATTRIBUTE NAME="Source filename" VALUE="$PMSourceFileDir\MBR_MASTER.dat"/>
  <ATTRIBUTE NAME="Output filename" VALUE="$PMTargetFileDir\SVC_VEST.dat"/>
</SESSION>
<SESSION NAME="s_m_BEN_CALC_03" MAPPINGNAME="m_BEN_CALC_03" ISVALID="YES">
  <ATTRIBUTE NAME="Source filename" VALUE="$PMTargetFileDir\SAL_EFF.dat;$PMTargetFileDir\SVC_VEST.dat"/>
  <ATTRIBUTE NAME="Output filename" VALUE="$PMTargetFileDir\BEN_PAY.dat"/>
  <ATTRIBUTE NAME="FAS window span" VALUE="10"/>
  <ATTRIBUTE NAME="FAS window size" VALUE="3"/>
</SESSION>

<WORKFLOW NAME="WF_M_PENS_CALC_03" ISVALID="YES" ISENABLED="YES" SUSPEND_ON_ERROR="NO">
  <SCHEDULER NAME="sch_MONTHLY_D3" TYPE="RUN ON SERVER INIT">
    <SCHEDULEINFO SCHEDULETYPE="CUSTOMREPEAT" INTERVAL="MONTHLY" DAYOFMONTH="3" STARTTIME="03:30:00"/>
  </SCHEDULER>
  <VARIABLE NAME="$$RUN_PRD_END" DATATYPE="date" ISNULL="NO"/>
  <TASKINSTANCE NAME="s_m_SAL_EFF_01" TASKTYPE="Session"/>
  <TASKINSTANCE NAME="s_m_SVC_VEST_02" TASKTYPE="Session"/>
  <TASKINSTANCE NAME="s_m_BEN_CALC_03" TASKTYPE="Session"/>
  <WORKFLOWLINK FROMTASK="Start" TOTASK="s_m_SAL_EFF_01" CONDITION=""/>
  <WORKFLOWLINK FROMTASK="s_m_SAL_EFF_01" TOTASK="s_m_SVC_VEST_02" CONDITION="$s_m_SAL_EFF_01.Status = SUCCEEDED"/>
  <WORKFLOWLINK FROMTASK="s_m_SVC_VEST_02" TOTASK="s_m_BEN_CALC_03" CONDITION="$s_m_SVC_VEST_02.Status = SUCCEEDED"/>
</WORKFLOW>

</FOLDER>
</REPOSITORY>
</POWERMART>
